# AI Configuration
# Global fallback — used by all operations unless overridden below
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=...

# Per-operation model overrides (optional — omit to use global AI_PROVIDER/AI_MODEL)
# Supported operations: INGEST, LINT (LINT also covers applying lint fixes)
# Example: use a cheaper/faster model for linting (and lint-fix) than ingest
#INGEST_AI_PROVIDER=openrouter
#INGEST_AI_MODEL=anthropic/claude-sonnet-4.6
#LINT_AI_PROVIDER=openrouter
#LINT_AI_MODEL=google/gemini-2.5-flash

# Portainer / Deployment Configuration
# Set DATA_DIR to the absolute path on your host (e.g. /home/colacho/docker/faragopedia)
DATA_DIR=.
# Set PUID and PGID to match your host user (run 'id' to find them)
PUID=1000
PGID=1000

# Port Configuration (change if ports 8300 or 5173 are already in use)
BACKEND_PORT=8300
FRONTEND_PORT=5173

# Frontend Configuration
VITE_ALLOWED_HOST=...
VITE_API_BASE_URL=http://localhost:8300

# External API Exposure (Cloudflare Tunnel)
# Required only if the backend is reachable via a public Cloudflare Tunnel route.
# Requests whose Host header matches FARAGOPEDIA_API_HOSTNAME must send a
# matching X-API-Key header on /api/* or they're rejected with 401. All other
# hostnames (e.g. the main frontend's) are never gated — do NOT key this off
# CF-Connecting-IP alone, Cloudflare adds that header to every tunneled
# request including normal browser traffic, not just this dedicated route.
# Generate the key with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#FARAGOPEDIA_API_KEY=...
#FARAGOPEDIA_API_HOSTNAME=faragopedia-api.ai-wise.uk
