# Copy to .env (ignored by git) and fill in.

# Faragopedia external API (ADR 0003): the gated API hostname, not the browser one.
FARAGOPEDIA_API_URL=https://<api-hostname>
FARAGOPEDIA_CF_CLIENT_ID=
FARAGOPEDIA_CF_CLIENT_SECRET=
FARAGOPEDIA_API_KEY=

# Farago "New Business" CRM spreadsheet (Outreach Log + Contacts + Companies tabs), read-only.
# Same OAuth client + refresh token the lead-gen automation uses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
