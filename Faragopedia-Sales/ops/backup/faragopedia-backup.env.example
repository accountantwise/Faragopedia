# Copy to /etc/faragopedia-backup.env (root:root, mode 600). Never commit the real one.
RESTIC_REPOSITORY=CHANGE_ME            # e.g. s3:https://s3.eu-central-003.backblazeb2.com/bucket/faragopedia
RESTIC_PASSWORD_FILE=/etc/faragopedia-backup.pass
# Provider credentials (S3-style shown):
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Optional dead-man's switch (healthchecks.io or Uptime Kuma push URL):
HEALTHCHECK_URL=
